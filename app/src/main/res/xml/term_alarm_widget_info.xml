<?xml version="1.0" encoding="utf-8"?>
<!--
    時計ウィジェットの大きさと更新間隔。

    既定は純正の時計ウィジェットと同じ2×2で配置される。
    置ける範囲を最小40dp(1×1マス相当)から最大640×480dpまで広げているのは、
    狭い場所では時刻だけの最小表示に、タブレットなどの広い画面では大きく引き伸ばして
    見やすく配置できるよう、TermAlarmWidgetが大きさに応じて中身を切り替えられるようにするため。

    previewLayoutで、一覧に出す見本に実際の見た目を使う。指定しないと白い枠に
    アプリのアイコンが出るだけになり、何が置かれるのか分からない。

    widgetFeaturesにreconfigurableを指定することで、ホーム画面でウィジェットを長押しした際に
    再設定ボタンを表示し、配置後でも見た目の設定画面（configureで指定したWidgetConfigActivity）を
    再度開けるようにする。ウィジェットを削除して置き直す手間なく、背景の出し方、時刻の色、書体、太さの
    設定を変更できるようにするために必要。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="640dp"
    android:maxResizeHeight="480dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:previewLayout="@layout/widget_preview"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:configure="com.marutyan.termalarm.widget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable" />
