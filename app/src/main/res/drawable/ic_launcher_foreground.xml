        android:strokeLineCap="round"
        android:pathData="M53.4,54.0 L43.580,48.779" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.346"
        android:strokeLineCap="round"
        android:pathData="M53.4,54.0 L64.439,47.367" />

    <!-- 針の軸 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M50.912,54.0 a2.488,2.488 0 1,0 4.976,0 a2.488,2.488 0 1,0 -4.976,0" />
</vector>
