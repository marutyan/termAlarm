    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 円の地。背景レイヤーと同じ色にして、ランチャーが丸く抜いても境目が出ない -->
    <path
        android:fillColor="#FF2B5CBB"
        android:pathData="M53.4,18.0 a36.0,36.0 0 1,0 0,72.0 a36.0,36.0 0 1,0 0,-72.0" />

    <path
        android:strokeColor="#FF8CDDC2"
        android:strokeWidth="4.215"
        android:strokeLineCap="butt"
        android:pathData="M54.336,36.142 A17.883,17.883 0 0 1 69.334,62.119" />
    <path
        android:strokeColor="#FF57B7C6"
        android:strokeWidth="4.215"
        android:strokeLineCap="butt"
        android:pathData="M68.398,63.740 A17.883,17.883 0 1 1 52.464,36.142" />
    <path
        android:strokeColor="#FFFEE48F"
        android:strokeWidth="4.302"
        android:strokeLineCap="butt"
        android:pathData="M54.698,29.229 A24.805,24.805 0 0 1 54.698,78.771" />
    <path
        android:strokeColor="#FFA9D1F5"
        android:strokeWidth="4.302"
        android:strokeLineCap="butt"
        android:pathData="M52.102,78.771 A24.805,24.805 0 0 1 32.597,67.510" />
    <path
        android:strokeColor="#FFA9D1F5"
